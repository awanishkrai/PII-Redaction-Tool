{
  "name": "pii-redaction-tool",
  "version": "1.0.0",
  "description": "PII redaction tool for SEBI Red Herring Prospectus documents",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "build:source": "node scripts/build-source-docx.js",
    "redact": "node src/index.js",
